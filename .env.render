# 🚀 RENDER.COM ENVIRONMENT VARIABLES
# Copy these variables to your Render service dashboard
# Last updated: August 27, 2025

# ==========================================
# CORE DJANGO CONFIGURATION
# ==========================================
DJANGO_SETTINGS_MODULE=inventory_app.settings_production
DEBUG=False

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
# Your current Supabase database URL
DATABASE_URL=postgresql://postgres.xuzylmblpkncyztcjrhh:B0t3co1027.@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ==========================================
# SECURITY & HOST CONFIGURATION
# ==========================================
# Current hosts (update your-app-name with actual Render app name)
DJANGO_ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1

# Your current secret key (keep this secure!)
DJANGO_SECRET_KEY=849b052a49e2110ca225ae04ffaf57ec9f71f5cdefb5b7150127b342e1d076e9

# ==========================================
# SSL/HTTPS SECURITY CONFIGURATION
# ==========================================
# Force HTTPS redirects
DJANGO_SECURE_SSL_REDIRECT=True

# HTTP Strict Transport Security (HSTS)
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True

# ==========================================
# ADDITIONAL SECURITY HEADERS
# ==========================================
# Prevent MIME-type sniffing
DJANGO_SECURE_CONTENT_TYPE_NOSNIFF=True

# Enable browser XSS filtering
DJANGO_SECURE_BROWSER_XSS_FILTER=True

# Referrer policy for privacy
DJANGO_SECURE_REFERRER_POLICY=strict-origin-when-cross-origin

# ==========================================
# SESSION & COOKIE SECURITY
# ==========================================
# Secure cookies (HTTPS only)
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True

# Cookie settings
DJANGO_SESSION_COOKIE_HTTPONLY=True
DJANGO_CSRF_COOKIE_HTTPONLY=True
DJANGO_SESSION_COOKIE_SAMESITE=Lax
DJANGO_CSRF_COOKIE_SAMESITE=Lax

# ==========================================
# SUPABASE INTEGRATION
# ==========================================
# Your current Supabase configuration
SUPABASE_URL=https://xuzylmblpkncyztcjrhh.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inh1enlsbWJscGtuY3l6dGNqcmhoIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc0NDc5NDkxNSwiZXhwIjoyMDYwMzcwOTE1fQ.qOeTKh3s_Rota_ZhCM1H7CLJIPIHstb3oZszl4LSnEA

# ==========================================
# STATIC FILES CONFIGURATION
# ==========================================
# Static files (handled by WhiteNoise)
STATIC_URL=/static/
STATIC_ROOT=staticfiles

# ==========================================
# CACHING CONFIGURATION
# ==========================================
# Redis cache (optional - uncomment if you add Redis)
# REDIS_URL=redis://localhost:6379/0

# ==========================================
# EMAIL CONFIGURATION (OPTIONAL)
# ==========================================
# Uncomment and configure if you need email functionality
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=Inventory App <your-email@gmail.com>

# ==========================================
# ERROR MONITORING (OPTIONAL)
# ==========================================
# Uncomment and configure for error tracking
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# SENTRY_ENVIRONMENT=production

# ==========================================
# LOGGING CONFIGURATION
# ==========================================
# Log level for production
DJANGO_LOG_LEVEL=INFO

# ==========================================
# PERFORMANCE SETTINGS
# ==========================================
# Database connection timeout
DATABASE_CONN_MAX_AGE=600

# ==========================================
# CONTENT SECURITY POLICY (OPTIONAL)
# ==========================================
# Uncomment for stricter CSP (test first!)
# CSP_DEFAULT_SRC='self'
# CSP_SCRIPT_SRC='self' 'unsafe-inline'
# CSP_STYLE_SRC='self' 'unsafe-inline'
# CSP_IMG_SRC='self' data: https:
# CSP_FONT_SRC='self' https://fonts.gstatic.com
# CSP_CONNECT_SRC='self'

# ==========================================
# ADMIN CONFIGURATION
# ==========================================
# Custom admin URL (optional security measure)
# DJANGO_ADMIN_URL=secure-admin-path/

# ==========================================
# API RATE LIMITING (OPTIONAL)
# ==========================================
# Uncomment if you want to configure rate limiting
# THROTTLE_ANON_RATE=100/hour
# THROTTLE_USER_RATE=1000/hour

# ==========================================
# TIMEZONE CONFIGURATION
# ==========================================
# Set your timezone
TIME_ZONE=UTC

# ==========================================
# LANGUAGE CONFIGURATION
# ==========================================
# Set your language
LANGUAGE_CODE=en-us
