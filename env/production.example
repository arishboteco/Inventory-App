# Production Environment Configuration
# NOTE: Do not commit live secrets. Copy to env/production.local and replace placeholders before production deployment.

# Django Core Configuration
DJANGO_SECRET_KEY=<PRODUCTION_SECRET_KEY>
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=inventory.yourdomain.com,www.yourdomain.com
DJANGO_SETTINGS_MODULE=inventory_app.settings.prod

# Database Configuration (REQUIRED)
DATABASE_URL=postgresql://<PROD_DB_USER>:<PROD_DB_PASSWORD>@<PROD_DB_HOST>:5432/<PROD_DB_NAME>

# Cache Configuration (RECOMMENDED)
REDIS_URL=redis://redis-prod-host:6379/0

# Email Configuration (REQUIRED for notifications)
EMAIL_HOST=smtp.yourdomain.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@yourdomain.com
EMAIL_HOST_PASSWORD=<EMAIL_HOST_PASSWORD>
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# Security Configuration
ADMIN_URL=secure-admin-path/
APP_VERSION=1.0.0

# Monitoring & Error Reporting (RECOMMENDED)
SENTRY_DSN=<SENTRY_DSN>

# Backup Configuration (RECOMMENDED)
BACKUP_LOCATION=/var/backups/inventory/

# SSL/TLS Configuration (REQUIRED for production)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Performance Settings
DATA_UPLOAD_MAX_MEMORY_SIZE=5242880
FILE_UPLOAD_MAX_MEMORY_SIZE=5242880

# Application-specific Settings
INVENTORY_ENABLE_AUDIT_LOGGING=True
INVENTORY_REQUIRE_SSL=True
INVENTORY_MAX_UPLOAD_SIZE=10485760

# Database Connection Settings
DB_CONN_MAX_AGE=600
DB_MAX_CONNS=20
DB_MIN_CONNS=5

# Rate Limiting
RATELIMIT_ENABLE=True
API_THROTTLE_ANON_RATE=100/hour
API_THROTTLE_USER_RATE=1000/hour

# Session Configuration
SESSION_COOKIE_AGE=3600
